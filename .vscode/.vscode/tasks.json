{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Code Quality Check",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/scripts/qguard-v7.py", "analyze", "${file}"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Security Check",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/scripts/qguard-v7.py", "security", "${workspaceFolder}"],
      "problemMatcher": []
    },
    {
      "label": "Generate PR Description",
      "type": "shell",
      "command": "python3",
      "args": ["${workspaceFolder}/scripts/fix_suggester.py", "pr-desc"],
      "problemMatcher": []
    }
  ]
}

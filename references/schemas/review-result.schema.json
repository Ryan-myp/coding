{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ryan-myp/coding/code-quality-guard/review-result.schema.json",
  "title": "Code Quality Review Result",
  "description": "Code quality review result schema",
  "type": "object",
  "required": ["file_path", "language", "score", "grade", "issues", "gate"],
  "properties": {
    "file_path": { "type": "string", "description": "Path to the reviewed file" },
    "language": { "type": "string", "enum": ["python", "typescript", "javascript", "go", "java", "rust", "unknown"] },
    "score": { "type": "number", "minimum": 0, "maximum": 100, "description": "Overall quality score" },
    "grade": {
      "type": "string",
      "enum": ["excellent", "good", "fair", "poor"],
      "description": "Grade name"
    },
    "grade_emoji": {
      "type": "string",
      "enum": ["🟢", "🟡", "🟠", "🔴"]
    },
    "axes": {
      "type": "object",
      "properties": {
        "correctness": { "type": "number", "minimum": 0, "maximum": 20 },
        "readability": { "type": "number", "minimum": 0, "maximum": 20 },
        "architecture": { "type": "number", "minimum": 0, "maximum": 25 },
        "security": { "type": "number", "minimum": 0, "maximum": 20 },
        "performance": { "type": "number", "minimum": 0, "maximum": 15 }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "axis", "message"],
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "warning", "info"] },
          "axis": { "type": "string", "enum": ["correctness", "readability", "architecture", "security", "performance"] },
          "line": { "type": "integer", "minimum": 1 },
          "message": { "type": "string" },
          "suggestion": { "type": "string" },
          "category": { "type": "string" }
        }
      }
    },
    "highlights": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gate": {
      "type": "string",
      "enum": ["pass", "conditional", "fail"],
      "description": "Merge gate decision"
    },
    "distillation_candidate": {
      "type": "boolean",
      "description": "Whether this code qualifies for pattern distillation"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

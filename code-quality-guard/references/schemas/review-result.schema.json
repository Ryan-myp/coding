{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review-result.schema.json",
  "title": "Code Quality Guard Review Result",
  "description": "五轴审查结果的标准格式",
  "type": "object",
  "required": ["file", "language", "composite_score", "grade", "gate", "axes"],
  "properties": {
    "file": {
      "type": "string",
      "description": "被审查的文件路径"
    },
    "language": {
      "type": "string",
      "enum": ["python", "typescript", "go", "java", "rust", "universal"],
      "description": "编程语言"
    },
    "composite_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "综合评分 (0-100)"
    },
    "grade": {
      "type": "string",
      "enum": ["Excellent", "Good", "Fair", "Poor"],
      "description": "质量等级"
    },
    "gate": {
      "type": "string",
      "enum": ["auto-approve", "conditional-pass", "needs-fix", "reject"],
      "description": "门禁判定"
    },
    "axes": {
      "type": "object",
      "required": ["correctness", "readability", "architecture", "security", "performance"],
      "properties": {
        "correctness": {
          "type": "object",
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 20 },
            "max": { "type": "number", "const": 20 },
            "percentage": { "type": "number" },
            "deductions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "readability": {
          "type": "object",
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 20 },
            "max": { "type": "number", "const": 20 },
            "percentage": { "type": "number" },
            "deductions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "architecture": {
          "type": "object",
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 25 },
            "max": { "type": "number", "const": 25 },
            "percentage": { "type": "number" },
            "deductions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "security": {
          "type": "object",
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 20 },
            "max": { "type": "number", "const": 20 },
            "percentage": { "type": "number" },
            "deductions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "performance": {
          "type": "object",
          "properties": {
            "score": { "type": "number", "minimum": 0, "maximum": 15 },
            "max": { "type": "number", "const": 15 },
            "percentage": { "type": "number" },
            "deductions": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "distillation_candidate": {
      "type": "boolean",
      "description": "是否满足蒸馏入库条件（≥90分）"
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
